#ifndef EDUOS_H
#define EDUOS_H

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <time.h>

typedef struct {
    pid_t pid;
    char name[64];
    int state;              // NEW, READY, RUNNING, WAITING, TERMINATED
    int priority;           // 0 = highest
    int burst_time;
    int arrival_time;
    int remaining_time;
    int memory_req_kb;
    int thread_count;
    time_t creation_time;
} PCB;

#endif
